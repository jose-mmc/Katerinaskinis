{% style %}
  .product__price {
    float: right;
    font-family: var(--ff-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--navy);
    padding-top: 0.35rem;
  }
{% endstyle %}

<section class="collection" id="collection" aria-labelledby="collection-heading">
  <div class="container">

    <header class="collection__header reveal">
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 id="collection-heading">{{ section.settings.heading }}</h2>
      <div class="rule rule--center"></div>
      <p>{{ section.settings.subheading }}</p>
    </header>

    <div class="collection__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          {%- liquid
            assign card_product = block.settings.product
            if card_product == blank and block.settings.product_handle != blank
              assign card_product = all_products[block.settings.product_handle]
            endif
            if card_product == blank
              assign kk_piece = block.settings.piece_label | strip | downcase
              assign kk_color = 'navy'
              assign kk_tag = block.settings.tag | strip | downcase
              if kk_tag contains 'cr'
                assign kk_color = 'creme'
              endif
              assign kk_handle = 'cannes-' | append: kk_piece | append: '-' | append: kk_color
              assign card_product = all_products[kk_handle]
            endif
          -%}
          <article class="product reveal d{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="product__frame">
              {%- if card_product != blank -%}<a href="{{ card_product.url }}" aria-label="View {{ card_product.title | escape }}">{%- endif -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}"
                     alt="{{ block.settings.name }}"
                     loading="lazy">
              {%- elsif card_product != blank and card_product.featured_image != blank and block.settings.image_asset == blank -%}
                <img src="{{ card_product.featured_image | image_url: width: 800 }}"
                     alt="{{ card_product.featured_image.alt | default: block.settings.name }}"
                     loading="lazy">
              {%- else -%}
                <img src="{{ block.settings.image_asset | asset_url }}"
                     alt="{{ block.settings.name }}"
                     loading="lazy">
              {%- endif -%}
              {%- if card_product != blank -%}</a>{%- endif -%}
            </div>
            <span class="product__piece-label">{{ block.settings.piece_label }}</span>
            <span class="product__tag">{{ block.settings.tag }}</span>
            <h3 class="product__name">{{ block.settings.name | default: card_product.title }}</h3>
            <p class="product__desc">{{ block.settings.description }}</p>
            <div class="product__meta">{{ block.settings.meta }}</div>

            {%- if card_product != blank -%}
              <a class="btn btn--solid product__cta" href="{{ card_product.url }}">
                {%- if block.settings.piece_label != blank -%}Shop the {{ block.settings.piece_label }}{%- else -%}View Product{%- endif -%}
              </a>
            {%- else -%}
              {%- comment -%} Fallback: product not yet connected — keep Jet-Set Club capture {%- endcomment -%}
              <button class="btn btn--solid product__cta jetset-open" type="button">{{ section.settings.card_cta_label | default: 'Get 15% Off' }}</button>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The First Launch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Cannes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One defining silhouette — the Cannes — in two colorways: deep metallic navy and crisp crème. A study in European proportion, structural precision, and coastal luminosity. Tops and bottoms sold separately."
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Fallback CTA label (card not linked to a product)",
      "default": "Get 15% Off"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify product",
          "info": "Link this card to a real product to enable Add to Cart."
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Product handle (fallback)",
          "info": "Used if no product is picked above, e.g. cannes-top-navy"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback asset filename",
          "info": "Filename of image in assets/ folder (used if no image uploaded above)"
        },
        {
          "type": "text",
          "id": "piece_label",
          "label": "Piece label (e.g. Top, Bottom)",
          "default": "Top"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag line",
          "default": "Deep Navy"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name",
          "default": "Cannes Top"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (fallback display only)",
          "default": "$54"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Showcase"
    }
  ]
}
{% endschema %}
