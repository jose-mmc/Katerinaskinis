<section class="collection" id="collection" aria-labelledby="collection-heading">
  <div class="container">

    <header class="collection__header reveal">
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 id="collection-heading">{{ section.settings.heading }}</h2>
      <div class="rule rule--center"></div>
      <p>{{ section.settings.subheading }}</p>
    </header>

    <div class="collection__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          <article class="product reveal d{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="product__frame">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}"
                     alt="{{ block.settings.name }}"
                     loading="lazy">
              {%- else -%}
                <img src="{{ block.settings.image_asset | asset_url }}"
                     alt="{{ block.settings.name }}"
                     loading="lazy">
              {%- endif -%}
            </div>
            <span class="product__piece-label">{{ block.settings.piece_label }}</span>
            <span class="product__tag">{{ block.settings.tag }}</span>
            <h3 class="product__name">{{ block.settings.name }}</h3>
            <p class="product__desc">{{ block.settings.description }}</p>
            <div class="product__meta">{{ block.settings.meta }}</div>
            <button class="btn btn--solid product__cta jetset-open" type="button">{{ section.settings.card_cta_label | default: 'Reserve — 15% Off' }}</button>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The First Launch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No.1 — The Cannes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One defining silhouette — the Cannes — in two colorways: deep metallic navy and crisp crème. A study in European proportion, structural precision, and coastal luminosity. Tops and bottoms sold separately."
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card CTA label",
      "default": "Reserve — 15% Off"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback asset filename",
          "info": "Filename of image in assets/ folder (used if no image uploaded above)"
        },
        {
          "type": "text",
          "id": "piece_label",
          "label": "Piece label (e.g. Top, Bottom)",
          "default": "Top"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag line",
          "default": "No.1 · Deep Navy"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name",
          "default": "Cannes Top"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta details"
        }
      ]
    }
  ],
    "presets": [
    {
      "name": "Collection Showcase",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "image_asset": "navy-top.png",
            "piece_label": "Top",
            "tag": "No.1 · Deep Navy",
            "name": "Cannes Top",
            "description": "The Cannes Top in deep metallic navy — a structured bandeau built with premium retention, perfect for long afternoons on the deck of a Riva. Pair it with its matching bottom or contrast it with crème.",
            "meta": "Deep metallic navy · Structured bandeau · Gold-toned hardware"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "image_asset": "navy-bottom.png",
            "piece_label": "Bottom",
            "tag": "No.1 · Deep Navy",
            "name": "Cannes Bottom",
            "description": "The Cannes Bottom in deep metallic navy, built for proportion and movement. Adjustable side-tie geometry creates a flawless, personalized contour.",
            "meta": "Deep metallic navy · Adjustable side ties · High waist option"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "image_asset": "cream-top.png",
            "piece_label": "Top",
            "tag": "No.1 · Crème",
            "name": "Cannes Top",
            "description": "The same Cannes silhouette in crisp crème — minimalist coastal elegance with a structured twist-knot bandeau designed for effortless movement from sea to terrace.",
            "meta": "Crisp crème · Structured bandeau · Internal boning"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "image_asset": "cream-bottom.png",
            "piece_label": "Bottom",
            "tag": "No.1 · Crème",
            "name": "Cannes Bottom",
            "description": "The Cannes Bottom in crisp crème, with adjustable tie geometry at both hips. Engineered for a contoured, European silhouette that moves as beautifully as it looks.",
            "meta": "Crisp crème · Side-tie bows · Adjustable fit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
