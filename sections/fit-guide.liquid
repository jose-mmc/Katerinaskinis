<section class="craft" id="fit-guide" aria-labelledby="craft-heading">
  <div class="craft__inner">

    <header class="craft__header reveal">
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 id="craft-heading">{{ section.settings.heading }}</h2>
      <div class="rule rule--center"></div>
      <p>{{ section.settings.subheading }}</p>
    </header>

    <div class="accordion reveal d1">

      <!-- Panel 1: Find Your Size -->
      <div class="accordion__item">
        <button class="accordion__btn"
                aria-expanded="false"
                aria-controls="panel-size"
                id="btn-size">
          <span class="accordion__btn-label">Find Your Size</span>
          <span class="accordion__btn-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="7" y1="1" x2="7" y2="13"/>
              <line x1="1" y1="7" x2="13" y2="7"/>
            </svg>
          </span>
        </button>
        <div class="accordion__body" id="panel-size" role="region" aria-labelledby="btn-size">
          <div class="accordion__body-inner">
            <p class="table-note">Measure around the fullest part of your bust. If you're between sizes, we recommend sizing up — every piece is cut with premium stretch.</p>
            <div class="size-scroll">
              <table class="size-table" aria-label="Size chart">
                <thead>
                  <tr>
                    <th scope="col">Size</th>
                    <th scope="col">Bust</th>
                    <th scope="col">Fit Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>XS</td>
                    <td>31.5&ndash;32.5 in</td>
                    <td>Petite frames</td>
                  </tr>
                  <tr>
                    <td>S</td>
                    <td>32.5&ndash;33.5 in</td>
                    <td>Our base fit</td>
                  </tr>
                  <tr>
                    <td>M</td>
                    <td>33.5&ndash;34.5 in</td>
                    <td>&nbsp;</td>
                  </tr>
                  <tr>
                    <td>L</td>
                    <td>34.5&ndash;35.5 in</td>
                    <td>&nbsp;</td>
                  </tr>
                  <tr>
                    <td>XL</td>
                    <td>35.5&ndash;36.5 in</td>
                    <td>&nbsp;</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="table-note" style="margin-top:1.25rem;">Bottoms are adjustable by design — side ties let you fine-tune the fit at both hips, in every size.</p>
          </div>
        </div>
      </div>

      <!-- Panel 2: Fit Notes -->
      <div class="accordion__item">
        <button class="accordion__btn"
                aria-expanded="false"
                aria-controls="panel-notes"
                id="btn-notes">
          <span class="accordion__btn-label">Fit &amp; Construction Notes</span>
          <span class="accordion__btn-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="7" y1="1" x2="7" y2="13"/>
              <line x1="1" y1="7" x2="13" y2="7"/>
            </svg>
          </span>
        </button>
        <div class="accordion__body" id="panel-notes" role="region" aria-labelledby="btn-notes">
          <div class="accordion__body-inner">
            <div class="size-scroll">
              <table class="size-table" aria-label="Fit and construction notes">
                <tbody>
                  <tr>
                    <td>Tops</td>
                    <td colspan="2">Structured bandeau silhouettes with internal boning at the side seams — real support that holds its shape from sea to terrace.</td>
                  </tr>
                  <tr>
                    <td>Bottoms</td>
                    <td colspan="2">Adjustable side-tie geometry at both hips creates a personalized contour and a forgiving, flexible fit.</td>
                  </tr>
                  <tr>
                    <td>Mix &amp; Match</td>
                    <td colspan="2">Tops and bottoms are sold separately — choose a different size for each, or pair deep navy with crème across the set.</td>
                  </tr>
                  <tr>
                    <td>Tolerance</td>
                    <td colspan="2">Every piece is cut to a ±0.25 in tolerance — pattern-room precision, not fast-fashion variance.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Technical Specifications -->
      <div class="accordion__item">
        <button class="accordion__btn"
                aria-expanded="false"
                aria-controls="panel-spec"
                id="btn-spec">
          <span class="accordion__btn-label">Technical Specifications — For the Detail-Obsessed</span>
          <span class="accordion__btn-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="7" y1="1" x2="7" y2="13"/>
              <line x1="1" y1="7" x2="13" y2="7"/>
            </svg>
          </span>
        </button>
        <div class="accordion__body" id="panel-spec" role="region" aria-labelledby="btn-spec">
          <div class="accordion__body-inner">
            <p class="table-note">Base size S, measured flat. Grading: ±1.0 in circumference and ±0.25 in length per size step (XL: +3.0 / +0.75 vs. base).</p>
            <div class="size-scroll">
              <table class="size-table" aria-label="Base size small measurements">
                <thead>
                  <tr>
                    <th scope="col">Measurement Point</th>
                    <th scope="col">Dimension</th>
                    <th scope="col">Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Bust Width (Relaxed)</td>
                    <td>14.75 in</td>
                    <td>Accommodates 33.5" bust with stretch</td>
                  </tr>
                  <tr>
                    <td>Bandeau Center Front Height</td>
                    <td>5.5 in</td>
                    <td>Vertical measurement at the twist-knot</td>
                  </tr>
                  <tr>
                    <td>Bandeau Side Seam Height</td>
                    <td>3.75 in</td>
                    <td>Where internal boning is located</td>
                  </tr>
                  <tr>
                    <td>Bottom Waist Width (Flat)</td>
                    <td>13 in</td>
                    <td>Adjustable via side ties</td>
                  </tr>
                  <tr>
                    <td>Front Rise</td>
                    <td>8.5 in</td>
                    <td>Center crotch seam to top of waist</td>
                  </tr>
                  <tr>
                    <td>Back Rise</td>
                    <td>7.75 in</td>
                    <td>Center crotch seam to top of waist</td>
                  </tr>
                </tbody>
              </table>
            </div>
            {%- if section.settings.spec_sheet != blank -%}
              <img src="{{ section.settings.spec_sheet | image_url: width: 1200 }}"
                   alt="Technical specification sheet — Katerina's Kinis base pattern"
                   style="width:100%;border:1px solid rgba(197,180,158,0.3);margin-top:1.25rem;">
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fit Guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Size & Fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to Fit, Made to Last"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your size in under a minute. Every piece is pattern-engineered for real support and real movement."
    },
    {
      "type": "image_picker",
      "id": "spec_sheet",
      "label": "Technical spec sheet image"
    }
  ],
  "presets": [
    {
      "name": "Fit Guide"
    }
  ]
}
{% endschema %}
