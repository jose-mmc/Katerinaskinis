<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <span class="ticker__item">
          {%- liquid
            assign kk_text = block.settings.text
            assign kk_check = kk_text | downcase
            if kk_check contains 'launching' or kk_check contains 'arriving'
              assign kk_text = 'Now Live · The Cannes Set'
            endif
          -%}
          <span class="ticker__text">{{ kk_text }}</span>
          <span class="ticker__dot"></span>
        </span>
      {%- endif -%}
    {%- endfor -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <span class="ticker__item">
          {%- liquid
            assign kk_text = block.settings.text
            assign kk_check = kk_text | downcase
            if kk_check contains 'launching' or kk_check contains 'arriving'
              assign kk_text = 'Now Live · The Cannes Set'
            endif
          -%}
          <span class="ticker__text">{{ kk_text }}</span>
          <span class="ticker__dot"></span>
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ticker",
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Now Live · The Cannes Set" } },
        { "type": "item", "settings": { "text": "The Cannes Set · Deep Navy & Crème" } },
        { "type": "item", "settings": { "text": "Tops & Bottoms Sold Separately" } }
      ]
    }
  ]
}
{% endschema %}
