<section class="hero" id="home" aria-label="Hero">
  <div class="hero__inner">

    <div class="hero__copy">
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="hero__title">{{ section.settings.title_line_1 }} <em>{{ section.settings.title_line_2 }}</em></h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>

      <div class="hero__actions">
        <button class="btn btn--solid" id="hero-jetset-btn">{{ section.settings.cta_label }}</button>
        <a class="btn btn--ghost" href="#collection">{{ section.settings.secondary_label }}</a>
      </div>
    </div>

    <div class="hero__gallery" aria-hidden="true">
      <figure class="hero__card hero__card--a">
        {%- if section.settings.image_a != blank -%}
          <img src="{{ section.settings.image_a | image_url: width: 900 }}" alt="">
        {%- else -%}
          <img src="{{ 'IMG_8106.jpeg' | asset_url }}" alt="">
        {%- endif -%}
        <figcaption>Cannes · Deep Navy</figcaption>
      </figure>
      <figure class="hero__card hero__card--b">
        {%- if section.settings.image_b != blank -%}
          <img src="{{ section.settings.image_b | image_url: width: 900 }}" alt="">
        {%- else -%}
          <img src="{{ 'IMG_8110.jpeg' | asset_url }}" alt="">
        {%- endif -%}
        <figcaption>Cannes · Crème</figcaption>
      </figure>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Katerina's Kinis · Est. 2026"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title (regular part)",
      "default": "The"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title (italic accent)",
      "default": "No.1"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Consciously crafted luxury swim essentials. One silhouette, two colorways — arriving August 2026."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "Join the Presale — 15% Off"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "View the Collection"
    },
    {
      "type": "image_picker",
      "id": "image_a",
      "label": "Gallery image — left (navy set)"
    },
    {
      "type": "image_picker",
      "id": "image_b",
      "label": "Gallery image — right (cream set)"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
